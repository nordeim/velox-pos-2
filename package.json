{
  "name": "veloxpos",
  "version": "1.0.0",
  "description": "VeloxPOS (Point Of Sale) — a production-ready POS web app (functional superset of veloxposen.base44.app) on Next.js 16 + React 19 + Prisma/SQLite.",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && rm -f .next/standalone/.env",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "db:push": "DATABASE_URL=\"file:../db/custom.db\" prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:seed": "DATABASE_URL=\"file:../db/custom.db\" bun prisma/seed.ts",
    "db:migrate": "DATABASE_URL=\"file:../db/custom.db\" prisma migrate dev",
    "db:reset": "DATABASE_URL=\"file:../db/custom.db\" prisma migrate reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "./scripts/smoke-test.sh",
    "gate": "bun run lint && bun run typecheck && bun run test && bun run build && ./scripts/smoke-test.sh && CI=1 bun run test:e2e",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.4.2",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.6.5",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "prisma",
    "unrs-resolver"
  ]
}
