// ---------------------------------------------------------------------------
// VeloxPOS — Prisma schema (the veloxposen.base44.app clone)
//
// DATABASE PATH CONTRACT (pinned by tests/db-path.test.ts — read .env.example):
//   DATABASE_URL="file:../db/custom.db" must resolve to <repo>/db/custom.db
//   for the Prisma CLI (schema-anchored) AND the runtime (src/lib/db-path.ts
//   applies the same rule). The `db:*` package scripts set the env var inline
//   (shell-provided → schema-anchored); never rely on repo-root .env
//   auto-loading with the raw CLI.
//
// Money: integer cents everywhere (*Cents columns). Floating-point money is
// the documented anti-pattern — the reference itself displayed a
// 1.7999999523162842 cost artifact; the clone never does.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  fullName      String   @default("")
  role          String   @default("cashier") // admin | cashier
  phone         String   @default("")
  active        Boolean  @default(true)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shifts      Shift[]
  sales       Sale[]
  categories  Category[]
  products    Product[]
  registers   Register[]
  storeSetting StoreSetting?
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#7c3aed")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([userId, name])
}

model Product {
  id         String   @id @default(cuid())
  userId     String
  name       String
  barcode    String
  categoryId String?
  priceCents Int      @default(0)
  costCents  Int      @default(0)
  stock      Int      @default(0)
  minStock   Int      @default(5)
  taxRate    Int      @default(16) // percent
  unit       String   @default("Piece")
  imageUrl   String   @default("")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems SaleItem[]

  @@unique([userId, barcode])
}

model Register {
  id        String   @id @default(cuid())
  userId    String
  name      String
  location  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shifts Shift[]
  sales  Sale[]

  @@unique([userId, name])
}

model Shift {
  id                String    @id @default(cuid())
  userId            String
  registerId        String
  openedAt          DateTime  @default(now())
  closedAt          DateTime?
  openingFloatCents Int       @default(0)
  expectedCashCents Int       @default(0) // float + cash sales, written at close
  closingCashCents  Int?
  status            String    @default("open") // open | closed
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  register Register  @relation(fields: [registerId], references: [id], onDelete: Cascade)
  sales    Sale[]
}

model Sale {
  id            String    @id @default(cuid())
  userId        String
  registerId    String
  shiftId       String
  ticketNo      String
  method        String    @default("cash") // cash | card | transfer | other
  status        String    @default("completed") // completed | refunded
  subtotalCents Int       @default(0)
  taxCents      Int       @default(0)
  discountCents Int       @default(0)
  totalCents    Int       @default(0)
  paidCents     Int       @default(0)
  changeCents   Int       @default(0)
  customerName  String    @default("")
  note          String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  register Register   @relation(fields: [registerId], references: [id], onDelete: Cascade)
  shift    Shift      @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  items    SaleItem[]

  @@unique([userId, ticketNo])
}

model SaleItem {
  id            String @id @default(cuid())
  saleId        String
  productId     String?
  name          String
  priceCents    Int
  qty           Int    @default(1)
  taxRate       Int    @default(16)
  lineTotalCents Int   @default(0)

  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model StoreSetting {
  id             String   @id @default(cuid())
  userId         String   @unique
  storeName      String   @default("VeloxPOS Store")
  address        String   @default("")
  phone          String   @default("")
  currency       String   @default("USD")
  receiptFooter  String   @default("Thank you for your purchase!")
  defaultTaxRate Int      @default(16)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---- auth-flow tokens (no SMTP: codes/links surface to the actor — ADR-013)

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
