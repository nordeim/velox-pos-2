// ---------------------------------------------------------------------------
// VeloxPOS — Prisma schema (7 models)
//
// DATABASE PATH CONTRACT (pinned by tests/db-path.test.ts — read .env.example):
//   DATABASE_URL="file:../db/custom.db" must resolve to <repo>/db/custom.db
//   for the Prisma CLI (schema-anchored) AND the runtime (src/lib/db-path.ts
//   applies the same rule). The `db:*` package scripts set the env var inline
//   (shell-provided → schema-anchored); never rely on repo-root .env
//   auto-loading with the raw CLI.
//
// Ownership: every user-owned model carries `userId` with onDelete: Cascade.
// Money: stored as REAL dollars (the reference displays $0.00); all math runs
// through src/lib/money.ts in integer cents and rounds only at the edge.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  fullName      String   @default("")
  role          String   @default("owner") // owner | cashier
  active        Boolean  @default(true)
  // Preferences (kept from the scaffolding's auth stack — the settings
  // surfaces read them through /api/auth/me)
  themeMode            String  @default("dark")
  accentColor          String  @default("violet")
  avatarEmoji          String  @default("")
  notificationsEnabled Boolean @default(true)
  emailVerified        Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products         Product[]
  categories       Category[]
  registers        Register[]
  cashierShifts    CashierShift[]
  sales            Sale[]
  storeSettings    StoreSettings?
  // (the named back-relations live on the fields below)
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  cashierShiftsAsCashier CashierShift[] @relation("ShiftCashier")
  salesAsCashier         Sale[]         @relation("SaleCashier")

  @@index([email])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  code      String // 6-digit OTP
  expiresAt DateTime // 15-minute window
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, code])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique // 48-hex one-shot
  expiresAt DateTime // 30-minute window
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StoreSettings {
  id             String  @id @default(cuid())
  userId         String  @unique
  storeName      String  @default("My Store")
  logoDataUrl    String?
  address        String  @default("")
  phone          String  @default("")
  email          String  @default("")
  taxId          String  @default("")
  currency       String  @default("USD")
  primaryColor   String  @default("#6366f1")
  secondaryColor String  @default("#8b5cf6")
  receiptFooter  String  @default("Thank you for your purchase!")
  // Fiscal / tax data (the reference's "Fiscal / Tax Data" card)
  hideFiscalOnReceipt Boolean @default(false)
  fiscalRuc           String  @default("")
  fiscalBusinessType  String  @default("")
  fiscalAddress       String  @default("")
  fiscalExpenseAccount String @default("")
  // "None" | "Stripe" | "SumUp" | "Square" — free-text-safe default
  cardProvider   String  @default("none")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#8b5cf6")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([userId, name])
  @@index([userId])
}

model Product {
  id         String    @id @default(cuid())
  userId     String
  name       String
  barcode    String    @default("")
  categoryId String?
  price      Float     @default(0) // selling price, dollars
  cost       Float? // unit cost, dollars
  stock      Float     @default(0)
  minStock   Float     @default(5)
  taxRate    Float     @default(16) // percent
  unit       String    @default("Piece") // Piece | Box | Kg | Liter | Pack
  image      String? // data URL (client-downscaled)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([categoryId])
  @@index([barcode])
}

model Register {
  id        String   @id @default(cuid())
  userId    String
  name      String
  location  String   @default("")
  status    String   @default("closed") // closed | open
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shifts    CashierShift[]
  sales     Sale[]

  @@index([userId])
}

model CashierShift {
  id           String    @id @default(cuid())
  userId       String
  registerId   String
  cashierId    String
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  openingFloat Float     @default(0)
  countedCash  Float?
  expectedCash Float?
  variance     Float?
  status       String    @default("active") // active | closed
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  register     Register  @relation(fields: [registerId], references: [id], onDelete: Cascade)
  cashier      User      @relation("ShiftCashier", fields: [cashierId], references: [id], onDelete: Cascade)
  sales        Sale[]

  @@index([userId])
  @@index([registerId, status])
  @@index([cashierId])
}

model Sale {
  id            String        @id @default(cuid())
  userId        String
  ticket        String // T-000001 — sequential per store
  items         String        @default("[]") // JSON [{productId,name,price,qty,taxRate}]
  subtotal      Float         @default(0)
  taxTotal      Float         @default(0)
  discountTotal Float         @default(0)
  total         Float         @default(0)
  paymentMethod String        @default("cash") // cash | card
  amountPaid    Float?
  changeDue     Float?
  customer      String        @default("")
  status        String        @default("completed") // completed | refunded
  cashierId     String
  registerId    String
  shiftId       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashier       User          @relation("SaleCashier", fields: [cashierId], references: [id], onDelete: Cascade)
  register      Register      @relation(fields: [registerId], references: [id], onDelete: Cascade)
  shift         CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([shiftId])
  @@index([createdAt])
}
